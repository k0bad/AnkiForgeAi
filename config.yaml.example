# Конфигурация AnkiCards
# Все пути относительные от корня проекта, если не указано иное

# Целевой язык изучения — код профиля из languages/{code}/language.yaml
language: en
# Язык подписей на бэк-стороне карточки: "ru" | "en"
ui_language: ru
# Тип транскрипции произношения:
#   practical — упрощённая запись кириллицей, ориентирована на русскоговорящих
#               без лингвистической подготовки (languages/{code}/prompts/russian_pronunciation.md)
#   ipa       — Международный фонетический алфавит, универсальный, но требует знания IPA
#               (languages/{code}/prompts/ipa_pronunciation.md)
transcription: practical

paths:
  db: data/ankicards.db
  logs_dir: data/logs
  audio_dir: media/audio
  images_dir: media/images
  prompts_dir: prompts

anki:
  # AnkiConnect должен быть запущен (Anki desktop + addon 2055492159)
  url: http://127.0.0.1:8765   # заменить на IP твоего Anki (напр. http://100.64.0.1:8765 через Tailscale)
  deck_name: English
  note_type: LanguageCard       # универсальное имя, создаётся `ankiforgeai init`
                                 # (должно совпадать с anki.note_type в languages/{language}/language.yaml)
  # Имена медиа-файлов: {ID}_nb.mp3 и {ID}.jpg
  # AnkiConnect копирует их в collection.media при push

dedupe:
  # Пороги сходства (rapidfuzz, 0-100)
  exact_match_field: Word        # точное совпадение по этому полю → merge
  fuzzy_threshold_review: 85     # >= 85 → обязательный ревью
  fuzzy_threshold_auto: 82       # 82-84 → полуавтомат
  # < 82 → автодобавление в режиме auto
  compare_fields: [Word, Translation]

ingest:
  # Парсинг URL
  url_max_size_mb: 5
  url_timeout_seconds: 30
  # Генерация по теме
  default_count: 20
  default_level: A2              # CEFR: A1, A2, B1, B2, C1, C2
  # Подсказка "пора на следующий уровень" при push — минимум карточек уровня в Anki
  # (по уровням — половина от исследовательских оценок объёма словаря на CEFR-уровень,
  # см. DEVELOPER_GUIDE.md; колода тут лишь часть общего словарного запаса, не
  # единственный источник) и доля "зрелых" (interval >= level_progress_mature_interval_days
  # дней — встроенное в Anki определение mature card), после которых её показывать.
  # C2 не включён — с него уже некуда переходить.
  level_progress_min_cards:
    a1: 250
    a2: 500
    b1: 1000
    b2: 2000
    c1: 4000
  level_progress_mature_ratio: 0.8
  level_progress_mature_interval_days: 21

llm:
  # Провайдер: "anthropic" (Claude API), "openrouter" (OpenAI-совместимые) или
  # "claude_cli" (локальный `claude` CLI headless, без своего ключа — см. .env.example;
  # расходует квоту твоей сессии Claude Code, не для частого cron)
  provider: openrouter
  # Модель у провайдера. Для claude_cli — алиас ("sonnet"/"opus"/"haiku") или полное
  # имя модели, НЕ формат "provider/model" как у OpenRouter
  model: deepseek/deepseek-v4-flash
  base_url: https://openrouter.ai/api/v1
  max_tokens: 4096
  temperature: 0.3               # ниже = стабильнее для словарных задач
  # Таймаут `claude -p` (только provider: claude_cli). Щедрый не просто так:
  # batch-стадии enrichment просят формы/примеры сразу на десятки слов, и такой
  # вызов легко идёт больше пяти минут
  claude_cli_timeout_seconds: 600
  # Промпты лежат в prompts/, перезагружаются при каждом вызове
  # (удобно итерировать без рестарта)

tts:
  # edge-tts голоса для английского
  voice_male: en-US-GuyNeural
  voice_female: en-US-JennyNeural
  default_voice: female
  rate: "+0%"                    # скорость: -50% .. +100%
  pitch: "+0Hz"

images:
  # Поиск картинок (опционально, можно отключить)
  enabled: true
  # Провайдер: unsplash | pexels | pixabay | openverse
  # Ключ нужного провайдера — в .env (см. .env.example). openverse ключа не требует.
  provider: unsplash
  # Опционально: если provider не нашёл картинку (пусто/нет ключа/403/429/5xx) —
  # пробовать эти провайдеры по очереди. Пусто по умолчанию = fallback выключен.
  fallback_providers: []         # напр. [pexels, pixabay, openverse]
  per_page: 5                    # сколько вариантов показывать на ревью
  # Качаем только для конкретных существительных (не абстрактных)
  only_for_pos: [noun]
  max_size_kb: 500
  resize_to: [600, 600]          # max ширина/высота

review:
  # Режим работы по умолчанию: manual / semiauto / auto
  mode: semiauto
  # В semiauto: автоматически коммитить кандидатов с score < fuzzy_threshold_auto
  auto_accept_below_score: true

enrich:
  # Какие стадии обогащения запускать (настраивается в setup wizard)
  grammar: true
  examples: true
  pronunciation: true

logging:
  level: INFO                    # DEBUG / INFO / WARNING / ERROR
  json_logs: true                # дублировать в JSON для машинной обработки
  human_logs: true               # человекочитаемый формат в stdout

tags:
  # Иерархические теги Anki (синтаксис ::)
  # Применяются автоматически на основе метаданных карточки
  topic_prefix: "topic"          # → topic::mat
  level_prefix: "level"          # → level::a2
  pos_prefix: "pos"              # → pos::noun
  source_prefix: "source"        # → source::nrk

notifications:
  # Каналы доставки отчёта scripts/daily_topic.py (--notify).
  # type: webhook — POST JSON на любой URL-посредник (n8n, Hermes, Zapier, свой шлюз-бот).
  # format: text (default) — готовое Telegram-flavored сообщение {"text": "..."}, под
  #                           n8n workflow (parse_mode: Markdown) или прямой relay в
  #                           Telegram Bot API.
  #         json            — сырой report целиком, без форматирования под конкретный
  #                           мессенджер — для посредника со своей маршрутизацией
  #                           (например Hermes: сам решает, в Telegram это, в другую
  #                           соцсеть или в AI-агента).
  # url: пусто здесь намеренно — этот файл коммитится в публичный репозиторий.
  #      Реальный адрес (может содержать bot-токен) кладётся в .env как
  #      NOTIFY_WEBHOOK_URL и переопределяет это поле (см. notify/webhook.py).
  - type: webhook
    enabled: false   # n8n немає — можна вимкнути (не заважає, просто зайвий warning у логах, якщо лишити true)
    format: text
    url: ""
  # - type: webhook
  #   enabled: false
  #   format: json
  #   url: "http://localhost:PORT/hermes-endpoint"

  # type: telegram — прямой Telegram Bot API, без n8n/Hermes-посредника (issue #55).
  # token: пусто здесь намеренно — реальный bot-токен кладётся в .env как
  #        NOTIFY_TELEGRAM_TOKEN (см. .env.example, notify/telegram.py).
  - type: telegram
    enabled: true
    chat_id: "727658367"
    # topic_id: 12345      # лише якщо пишеш у конкретну тему групи
    parse_mode: "Markdown" # це і так дефолт, можна не вказувати
# Скопируй в .env и заполни своими ключами.
# .env в .gitignore — не коммить!

# ─── Провайдер: OpenRouter (по умолчанию) ───
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here
# ─── Провайдер: Anthropic Claude (альтернатива) ───
# Ключ: https://console.anthropic.com/
# Нужен только если в config.yaml llm.provider = "anthropic"
ANTHROPIC_API_KEY=your-anthropic-key-here

# ─── Картинки: провайдер выбирается config.yaml -> images.provider ───
# Нужен только ключ выбранного провайдера — остальные можно не заполнять.

# Provider: unsplash (по умолчанию)
# Ключ: https://unsplash.com/developers — бесплатно, 50 запросов/час
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Provider: pexels
# Ключ: https://www.pexels.com/api/ — бесплатно, 200 запросов/час
PEXELS_API_KEY=your-pexels-api-key

# Provider: pixabay
# Ключ: https://pixabay.com/api/docs/ — бесплатно, 100 запросов/60с
PIXABAY_API_KEY=your-pixabay-api-key

# Provider: openverse — ключ не нужен (анонимный доступ, ниже rate limit)
# https://api.openverse.org/v1/#tag/auth

# ─── Уведомления: type: telegram (прямой Bot API, без n8n-посредника) ───
# Токен бота — получить у @BotFather в Telegram. Держи только здесь:
# config.yaml коммитится в публичный репозиторий, а notifications[].token
# там намеренно пуст (см. notify/telegram.py).
NOTIFY_TELEGRAM_TOKEN=your-telegram-bot-token